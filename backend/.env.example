PORT=5000
NODE_ENV=development
# Comma-separated browser origins permitted to call this API. In production,
# include the Railway frontend URL and the final Hostinger custom domain.
FRONTEND_URL=http://localhost:5173

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGO_DB_NAME=smackathon_2k26

# Admin JWT (used for admin panel authentication)
JWT_SECRET=generate-a-unique-random-secret-with-at-least-32-characters
JWT_EXPIRES_IN=7d

# Registration JWT (required in production; local development derives a scoped key if omitted)
REGISTRATION_JWT_SECRET=generate-a-different-random-secret-with-at-least-32-characters
REGISTRATION_ACCESS_TTL=2h

# Admin bootstrap (used by seed/seedAdmin.js)
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-unique-long-admin-password
ADMIN_EMAIL=admin@example.com

# Cloudinary (payment screenshot uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_PAYMENT_FOLDER=smackathon/payment-proofs
PAYMENT_SCREENSHOT_MAX_BYTES=2097152
CLOUDINARY_UPLOAD_TIMEOUT_MS=30000
CLOUDINARY_DELETE_TIMEOUT_MS=15000

# Smackathon payment details shown on the registration page.
# Use public image URLs. Public Google Drive share links are supported.
SMACKATHON_UPI_ID_1=first-upi-id@bank
SMACKATHON_PAYEE_NAME_1=First account holder name
SMACKATHON_QR_IMAGE_URL_1=https://drive.google.com/file/d/FILE_ID_1/view?usp=sharing
SMACKATHON_UPI_ID_2=second-upi-id@bank
SMACKATHON_PAYEE_NAME_2=Second account holder name
SMACKATHON_QR_IMAGE_URL_2=https://drive.google.com/file/d/FILE_ID_2/view?usp=sharing
