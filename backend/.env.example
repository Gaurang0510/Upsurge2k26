PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGO_DB_NAME=smackathon_2k26

# Admin JWT (used for admin panel authentication)
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d

# Registration JWT (separate secret for registration access tokens)
REGISTRATION_JWT_SECRET=replace-with-different-long-random-secret
REGISTRATION_ACCESS_TTL=2h

# Admin bootstrap (used by seed/seedAdmin.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@example.com

# Cloudinary (payment screenshot uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_PAYMENT_FOLDER=smackathon/payment-proofs
PAYMENT_SCREENSHOT_MAX_BYTES=2097152
CLOUDINARY_UPLOAD_TIMEOUT_MS=30000
CLOUDINARY_DELETE_TIMEOUT_MS=15000

# Smackathon payment details
SMACKATHON_UPI_ID=your-upi-id@bank
SMACKATHON_PAYEE_NAME=YCCE CSE Department
SMACKATHON_QR_IMAGE_URL=https://example.com/path-to-qr-image.png
